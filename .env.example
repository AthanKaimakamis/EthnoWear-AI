# SQL Server requires a strong password containing upper/lowercase letters,
# a number, and a symbol. Copy this file to .env and replace the value.
MSSQL_SA_PASSWORD=ChangeMe_Strong123!
MSSQL_PORT=1433
MSSQL_PID=Developer
MSSQL_PLATFORM=linux/amd64
FRONTEND_PORT=5173
BACKEND_PORT=8080
# Used only with compose.qdrant-local.yml for localhost diagnostics.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
OLLAMA_PORT=11435
# Central endpoint used by retrieval, chat, and the vision worker.
ETHNOWEAR_OLLAMA_BASE_URL=http://host.docker.internal:11434
ETHNOWEAR_RETRIEVAL_ENABLED=true
ETHNOWEAR_RETRIEVAL_MINIMUM_SIMILARITY=0.42
ETHNOWEAR_RETRIEVAL_EMBEDDING_TIMEOUT=60s
ETHNOWEAR_RETRIEVAL_QDRANT_TIMEOUT=10s
ETHNOWEAR_CONVERSATION_GENERATION_ENABLED=true
ETHNOWEAR_CONVERSATION_GENERATION_TIMEOUT=5m
ETHNOWEAR_CONVERSATION_SSE_HEARTBEAT_INTERVAL=20s
ETHNOWEAR_CONVERSATION_MAXIMUM_TURNS_PER_MINUTE=10
ETHNOWEAR_CONVERSATION_MAXIMUM_TRACKED_OWNERS=10000
ETHNOWEAR_CONVERSATION_MAXIMUM_HISTORY_TURNS=6
ETHNOWEAR_CONVERSATION_MAXIMUM_HISTORY_CHARACTERS=12000
ETHNOWEAR_EMBEDDING_MODEL=bge-m3
ETHNOWEAR_CHAT_MODEL=qwen3:8b
ETHNOWEAR_VISION_MODEL=qwen3-vl:8b
ETHNOWEAR_EMBEDDING_DIMENSIONS=1024
ETHNOWEAR_QDRANT_COLLECTION=ethnowear_chunks_bge_m3_v1
# Absolute paths are recommended outside local development. Compose defaults to ./media.
ETHNOWEAR_MEDIA_ROOT=./media
# Use at least 32 unpredictable UTF-8 bytes. Never commit the real value.
ETHNOWEAR_JWT_SECRET=ChangeThisJwtSecretWithAtLeast32Bytes!
ETHNOWEAR_JWT_ISSUER=ethnowear-api
ETHNOWEAR_JWT_TTL=1h

# Optional public Google sign-in. Management JWT authentication is separate.
ETHNOWEAR_PUBLIC_AUTH_ENABLED=false
ETHNOWEAR_GOOGLE_CLIENT_ID=
ETHNOWEAR_PUBLIC_AUTH_SECURE_COOKIES=true
ETHNOWEAR_PUBLIC_SESSION_TTL=7d
ETHNOWEAR_PUBLIC_AUTH_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Use at least 32 cryptographically random UTF-8 bytes. Never commit the real value.
ETHNOWEAR_WORKER_API_TOKEN=ReplaceThisWorkerTokenWithAtLeast32RandomBytes!
# Future worker containers connect to Spring through the Compose network.
ETHNOWEAR_WORKER_BACKEND_URL=http://api:8080
ETHNOWEAR_WORKER_RECOVERY_INTERVAL=30s
ETHNOWEAR_WORKER_MAXIMUM_PAGE_PIXELS=100000000
ETHNOWEAR_WORKER_MAXIMUM_OCR_TEXT_CHARACTERS=2000000
ETHNOWEAR_WORKER_MAXIMUM_OCR_OUTPUT_SIZE=10MB
ETHNOWEAR_WORKER_MAXIMUM_OCR_CONTEXT_SIZE=16MB
ETHNOWEAR_WORKER_MAXIMUM_QUALITY_ASSESSMENT_PAYLOAD_SIZE=1MB
ETHNOWEAR_WORKER_MAXIMUM_QUALITY_SIGNALS=100
ETHNOWEAR_WORKER_MAXIMUM_QUALITY_SIGNAL_TYPE_CHARACTERS=100
ETHNOWEAR_WORKER_MAXIMUM_QUALITY_SIGNAL_TEXT_CHARACTERS=500
ETHNOWEAR_WORKER_MAXIMUM_QUALITY_SUMMARY_CHARACTERS=1000
ETHNOWEAR_WORKER_MAXIMUM_QUALITY_LIMITATIONS_CHARACTERS=1000
ETHNOWEAR_WORKER_MAXIMUM_QUALITY_MESSAGE_CHARACTERS=1000
ETHNOWEAR_WORKER_MAXIMUM_VISION_ASSESSMENT_PAYLOAD_SIZE=10MB
ETHNOWEAR_WORKER_MAXIMUM_VISION_SUGGESTION_CHARACTERS=2000000
ETHNOWEAR_WORKER_MAXIMUM_VISION_ISSUES_JSON_CHARACTERS=4000
ETHNOWEAR_WORKER_MAXIMUM_VISION_ISSUES=100
ETHNOWEAR_WORKER_MAXIMUM_VISION_UNCERTAIN_PASSAGES=100
ETHNOWEAR_WORKER_MAXIMUM_VISION_ISSUE_CODE_CHARACTERS=100
ETHNOWEAR_WORKER_MAXIMUM_VISION_EXCERPT_CHARACTERS=500
ETHNOWEAR_WORKER_MAXIMUM_VISION_REASON_CHARACTERS=1000
ETHNOWEAR_WORKER_MAXIMUM_VISION_MODEL_NAME_CHARACTERS=100
ETHNOWEAR_WORKER_MAXIMUM_VISION_MODEL_VERSION_CHARACTERS=100
ETHNOWEAR_WORKER_MAXIMUM_VISION_PROMPT_VERSION_CHARACTERS=100
ETHNOWEAR_WORKER_MAXIMUM_FIGURE_CANDIDATES=100
ETHNOWEAR_WORKER_MAXIMUM_FIGURE_CAPTION_CHARACTERS=2000
ETHNOWEAR_WORKER_MAXIMUM_PRINTED_FIGURE_NUMBER_CHARACTERS=100
ETHNOWEAR_WORKER_MAXIMUM_FIGURE_CROP_SIZE=25MB
ETHNOWEAR_WORKER_ID=page-extractor-1
ETHNOWEAR_FIGURE_WORKER_ID=figure-worker-1
ETHNOWEAR_WORKER_POLL_MIN_SECONDS=1
ETHNOWEAR_WORKER_POLL_MAX_SECONDS=30
ETHNOWEAR_WORKER_HTTP_CONNECT_TIMEOUT_SECONDS=10
ETHNOWEAR_WORKER_HTTP_READ_TIMEOUT_SECONDS=60
ETHNOWEAR_WORKER_OCR_MAXIMUM_LAYOUT_REGIONS=32
ETHNOWEAR_FIGURE_CROP_MARGIN_RATIO=0.015
ETHNOWEAR_FIGURE_MAXIMUM_LOCAL_CANDIDATES=100
ETHNOWEAR_FIGURE_JPEG_QUALITY=95
ETHNOWEAR_FIGURE_WORKER_MEMORY_LIMIT=1g
ETHNOWEAR_FIGURE_WORKER_CPU_LIMIT=1.0
ETHNOWEAR_FIGURE_WORKER_PIDS_LIMIT=64
ETHNOWEAR_FIGURE_WORKER_STOP_GRACE_PERIOD=5m
