#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: $0 <native|container> <docker compose arguments...>" >&2
  echo "Example: $0 container up -d --build" >&2
  exit 64
}

if [[ $# -lt 2 ]]; then
  usage
fi

mode="$1"
shift

case "$mode" in
  native|container)
    mode_file="config/ollama-${mode}.env"
    ;;
  *)
    usage
    ;;
esac

if [[ ! -f .env ]]; then
  echo "Missing .env. Copy .env.example to .env and configure its secrets first." >&2
  exit 66
fi

exec docker compose \
  --env-file .env \
  --env-file "$mode_file" \
  "$@"
