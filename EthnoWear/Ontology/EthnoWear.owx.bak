  <owl:Class rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#GaitanTechnique">
    <skos:altLabel xml:lang="bg">Гайтани</skos:altLabel>
    <skos:altLabel xml:lang="bg">Гайтанджийски бодове</skos:altLabel>
