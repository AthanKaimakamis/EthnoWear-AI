<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:ew="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
  <owl:Ontology rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear"/>
  <owl:Class rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#Embroidery">
    <skos:altLabel xml:lang="bg">Бродерия</skos:altLabel>
    <rdfs:label xml:lang="bg">Шевица</rdfs:label>
    <rdfs:label xml:lang="en">Embroidery</rdfs:label>
    <rdfs:comment xml:lang="bg">Традиционен български везбен мотив, представен чрез своя регион, цветове, техники и орнаменти.</rdfs:comment>
    <rdfs:comment xml:lang="en">A traditional Bulgarian embroidery pattern represented by its region, colors, techniques, and ornaments.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#Motif">
    <rdfs:label xml:lang="bg">Мотив</rdfs:label>
    <rdfs:label xml:lang="en">Motif</rdfs:label>
    <rdfs:comment xml:lang="bg">Композиционна декоративна единица в шевицата, изградена от орнаменти, цветове и техники.</rdfs:comment>
    <rdfs:comment xml:lang="en">A composed decorative unit in embroidery, built from ornaments, colors, and techniques.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#TechniqueName">
    <rdfs:label xml:lang="bg">Название на техника</rdfs:label>
    <skos:altLabel xml:lang="bg">Име на техника</skos:altLabel>
    <skos:altLabel xml:lang="bg">Име на бод</skos:altLabel>
    <skos:altLabel xml:lang="bg">Название на бод</skos:altLabel>
    <rdfs:label xml:lang="en">Technique name</rdfs:label>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:onClass>
          <owl:Class rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#Technique"/>
        </owl:onClass>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"
        >1</owl:qualifiedCardinality>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#isNameOf"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:allValuesFrom>
          <owl:Class rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#Technique"/>
        </owl:allValuesFrom>
        <owl:onProperty>
          <owl:ObjectProperty rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#isNameOf"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <skos:altLabel xml:lang="en">Stitch name</skos:altLabel>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#Name"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#HumanOrnament">
    <rdfs:label xml:lang="bg">Човешки орнамент</rdfs:label>
    <rdfs:label xml:lang="en">Human ornament</rdfs:label>
    <rdfs:comment xml:lang="bg">Орнамент, представящ човешка фигура или стилизиран човешки образ.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ornament representing a human figure or a stylized human form.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#Ornament"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#Technique">
    <skos:altLabel xml:lang="bg">Бод</skos:altLabel>
    <skos:altLabel xml:lang="en">Stitch</skos:altLabel>
    <rdfs:label xml:lang="bg">Техника</rdfs:label>
    <rdfs:label xml:lang="en">Technique</rdfs:label>
    <rdfs:comment xml:lang="bg">Везбен бод или техника, използвани при създаването на шевица.</rdfs:comment>
    <rdfs:comment xml:lang="en">A stitch or technique used to create an embroidery.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#RegionGroup">
    <skos:altLabel xml:lang="bg">Група райони</skos:altLabel>
    <rdfs:label xml:lang="bg">Група рegйони</rdfs:label>
    <rdfs:label xml:lang="en">Region group</rdfs:label>
    <rdfs:comment xml:lang="bg">Обобщена група от везбени региони, използвана за организиране на регионални традиции, например западни или източни региони.</rdfs:comment>
    <rdfs:comment xml:lang="en">A broad grouping of embroidery regions used to organize regional traditions, such as western or eastern embroidery regions.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#KulaVidinEmbroidery">
    <skos:altLabel xml:lang="bg">Кулско-видинска бродерия</skos:altLabel>
    <rdfs:label xml:lang="bg">Кулско-видинска шевица</rdfs:label>
    <rdfs:label xml:lang="en">Kula-Vidin embroidery</rdfs:label>
    <rdfs:subClassOf>
      <owl:Restriction>
        <owl:hasValue>
          <ew:Region rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#KulaVidinRegion">
            <skos:altLabel xml:lang="bg">Кулско-видински район</skos:altLabel>
            <skos:altLabel xml:lang="bg">Кулско-видинска</skos:altLabel>
            <rdfs:label xml:lang="bg">Кулско-видински регион</rdfs:label>
            <rdfs:label xml:lang="en">Kula-Vidin embroidery region</rdfs:label>
            <ew:belongsToRegionGroup>
              <ew:RegionGroup rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#WesternRegionGroup">
                <skos:altLabel xml:lang="bg">Западни райони</skos:altLabel>
                <rdfs:label xml:lang="bg">Западни региони</rdfs:label>
                <rdfs:label xml:lang="en">Western embroidery regions</rdfs:label>
                <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
              </ew:RegionGroup>
            </ew:belongsToRegionGroup>
            <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
          </ew:Region>
        </owl:hasValue>
        <owl:onProperty>
          <owl:FunctionalProperty rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#hasRegion"/>
        </owl:onProperty>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Class rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#RegionalEmbroidery"/>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#ContourTechnique">
    <skos:altLabel xml:lang="bg">Контурни бодове</skos:altLabel>
    <skos:altLabel xml:lang="bg">Контури</skos:altLabel>
    <skos:altLabel xml:lang="en">Contour stitches</skos:altLabel>
    <rdfs:label xml:lang="bg">Контурни техники</rdfs:label>
    <rdfs:label xml:lang="en">Contour techniques</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#Technique"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.semanticweb.org/athan/ontologies/2026/4/ethno-wear#Region">
    <skos:altLabel xml:lang="bg">Район</skos:altLabel>
    <rdfs:label xml:lang="bg">Регион</rdfs:label>
    <rdfs:label xml:lang="en">Region</rdfs:label>
    <rdfs:comment xml:lang="bg">Етнографски регион, свързан с традициите в българската шевица.</rdfs:comment>
    <rdfs:comment xml:lang="en">An ethnographic region associated with Bulgarian embroidery traditions.</rdfs:comment>
  </owl:Class>
