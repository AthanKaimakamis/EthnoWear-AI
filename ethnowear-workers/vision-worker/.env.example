ETHNOWEAR_WORKER_BASE_URL=http://localhost:8080
ETHNOWEAR_WORKER_ID=vision-worker-1
ETHNOWEAR_WORKER_API_TOKEN=replace-with-a-secret-containing-at-least-32-bytes

ETHNOWEAR_OLLAMA_BASE_URL=http://localhost:11434
ETHNOWEAR_VISION_MODEL=qwen3-vl:8b
ETHNOWEAR_VISION_PROMPT_VERSION=vision-ocr-v8

ETHNOWEAR_WORKER_POLL_MIN_SECONDS=1
ETHNOWEAR_WORKER_POLL_MAX_SECONDS=30
ETHNOWEAR_WORKER_LEASE_SECONDS=120
ETHNOWEAR_WORKER_HTTP_CONNECT_TIMEOUT_SECONDS=10
ETHNOWEAR_WORKER_HTTP_READ_TIMEOUT_SECONDS=60
ETHNOWEAR_VISION_TIMEOUT_SECONDS=600
ETHNOWEAR_VISION_MAXIMUM_OUTPUT_BYTES=1048576
ETHNOWEAR_VISION_CONTEXT_TOKENS=16384
ETHNOWEAR_VISION_MAXIMUM_GENERATED_TOKENS=4096
ETHNOWEAR_VISION_MAXIMUM_IMAGE_EDGE_PIXELS=2048
ETHNOWEAR_VISION_IMAGE_JPEG_QUALITY=90
ETHNOWEAR_WORKER_TEMPORARY_ROOT=/tmp/ethnowear-vision-worker
